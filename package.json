{
	"name": "damascus",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"repository": "https://github.com/beaurancourt/damascus.git",
	"homepage": "https://github.com/beaurancourt/damascus",
	"scripts": {
		"start": "npm install && vite --host",
		"update": "npx npm-check-updates --peer --interactive --format group",
		"lint": "eslint \"src/**/*.{ts,tsx}\" --concurrency auto",
		"lint:fix": "eslint \"src/**/*.{ts,tsx}\" --concurrency auto --fix",
		"test": "vitest",
		"check": "npm run lint && tsc -p tsconfig.json && vitest run && npm audit",
		"build": "vite build"
	},
	"dependencies": {
		"@ant-design/icons": "^6.2.3",
		"@dnd-kit/core": "^6.3.1",
		"@mdxeditor/editor": "^4.0.0",
		"@types/showdown": "^2.0.6",
		"antd": "^6.4.3",
		"js-yaml": "^4.1.1",
		"localforage": "^1.10.0",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"react-router": "^7.15.1",
		"sass": "^1.99.0",
		"showdown": "^2.1.0",
		"uuid": "^14.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/gtag.js": "^0.0.20",
		"@types/js-yaml": "^4.0.9",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.2",
		"@vitest/coverage-v8": "^4.1.6",
		"esbuild": "^0.28.0",
		"eslint": "^10.4.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.3",
		"vite": "^8.0.13",
		"vitest": "^4.1.6"
	}
}
